{
  "name": "agentdeck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx app/server/main.ts --dev",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/server/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:example": "vite build --config examples/company/tool/vite.config.ts",
    "background:install": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/agentdeck.ps1 -Action Install",
    "background:start": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/agentdeck.ps1 -Action Start",
    "background:stop": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/agentdeck.ps1 -Action Stop",
    "background:restart": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/agentdeck.ps1 -Action Restart",
    "background:update": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/agentdeck.ps1 -Action Update",
    "background:status": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/agentdeck.ps1 -Action Status",
    "background:uninstall": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/agentdeck.ps1 -Action Uninstall"
  },
  "dependencies": {
    "fastify": "^5.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
